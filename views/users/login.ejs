<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <h1 class="col-6 offset-3">Login to wonderlust</h1>
        <div class="col-6 offset-3">
            <form action="/login" method="post" novalidate class="needs-validation">
                <div class="mb-3">
                    <lable for="username" class="form-label">username</lable>
                    <input name="username" id="username" type="text" class="form-control" required />
                </div>
                <!-- <div class="mb-3">
                    <lable for="email" class="form-label">Email</lable>
                    <input name="email" id="email" type="email" class="form-control" required />
                </div> -->
                <div class="mb-3">
                    <lable for="password" class="Email">Password</lable>
                    <input name="password" id="password" type="password" class="form-control" required />
           </div>
           <button class="btn btn-success">Login</button>
            </form>
        </div>
    </div>